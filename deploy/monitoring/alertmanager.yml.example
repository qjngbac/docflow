global:
  resolve_timeout: 5m

route:
  receiver: docflow-operations
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: docflow-operations
    webhook_configs:
      - url: https://alerts.example.com/hooks/docflow
        send_resolved: true

inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, instance]
