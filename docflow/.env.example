MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_SSL_ENABLE=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
APP_ENV=development
APP_VERIFICATION_DEBUG_CODE=true
VERIFICATION_EXPIRE_MINUTES=10
VERIFICATION_COOLDOWN_SECONDS=60
