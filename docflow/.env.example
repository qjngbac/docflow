AUTH_TOUCH_INTERVAL_SECONDS=60
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
FILE_PUBLIC_ACCESS_ENABLED=true
FILE_SIGNING_SECRET=replace-with-a-separate-long-random-secret
