SECURITY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
SECURITY_IP_DENY_LIST=
SECURITY_STATE_FAIL_CLOSED=false
RATE_LIMIT_GENERAL_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_SHARE_PER_MINUTE=60
LOGIN_CAPTCHA_AFTER_FAILURES=3
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_FAILURE_OBSERVATION_MINUTES=15
LOGIN_ACCOUNT_LOCK_MINUTES=15
LOGIN_IP_LOCK_MINUTES=30
LOGIN_CAPTCHA_EXPIRE_MINUTES=5
